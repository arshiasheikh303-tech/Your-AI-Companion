# --- Required ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# --- Companion identity (easy to change) ---
COMPANION_NAME=Nova
USER_NAME=
TIMEZONE=America/Los_Angeles

# --- Local AI (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
AI_PROVIDER=ollama

# --- Database ---
DATABASE_URL=sqlite:///./data/agent.db

# --- Conversation context ---
RECENT_MESSAGES_LIMIT=20
MEMORY_CONTEXT_LIMIT=12

# --- Proactive messaging ---
PROACTIVE_ENABLED=true
PROACTIVE_CHECK_INTERVAL_MINUTES=20
MIN_TIME_BETWEEN_PROACTIVE_MESSAGES_HOURS=3
INACTIVITY_THRESHOLD_HOURS=6
MAX_PROACTIVE_MESSAGES_PER_DAY=4
QUIET_HOURS_START=23:00
QUIET_HOURS_END=08:00
# Escalation (follow-up after an unanswered proactive message)
ESCALATION_ENABLED=false
ESCALATION_WAIT_HOURS=4
ESCALATION_VOICE_ENABLED=false

# --- Voice ---
VOICE_INPUT_ENABLED=true
VOICE_RESPONSES=false
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_BINARY=piper
PIPER_MODEL_PATH=

# --- Optional web search (DuckDuckGo needs no key; set to "none" to disable) ---
SEARCH_PROVIDER=duckduckgo

# --- API / dashboard ---
API_HOST=127.0.0.1
API_PORT=8000
# Protects /api endpoints and the dashboard. Leave empty to auto-generate one at first run.
API_TOKEN=

LOG_LEVEL=INFO
